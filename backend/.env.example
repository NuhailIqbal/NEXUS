# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# VAPI (fill in Part 2)
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
# Background auto-sync of VAPI calls (recording + transcript). Set interval to 0 to disable.
VAPI_SYNC_INTERVAL_SECONDS=90
VAPI_SYNC_LIMIT=50

# Gemini (fill in Part 4)
GEMINI_API_KEY=

# OpenAI (agent "Test" feature)
OPENAI_API_KEY=

# Admin portal login (server-side; NOT shipped to the browser).
# Defaults are qarib/test123 for local dev — MUST be overridden in production.
ADMIN_USERNAME=qarib
ADMIN_PASSWORD=test123

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# One-time welcome bonus (wallet $) for new signups; 0 disables it.
SIGNUP_BONUS_CREDITS=20

# System (transactional) email — sent directly via Python's smtplib using Gmail SMTP.
# SYSTEM_SMTP_PASSWORD must be a Gmail App Password (Google Account > Security >
# 2-Step Verification > App Passwords), NOT your regular account password — Gmail
# rejects plain-password SMTP logins. Leave username/password blank to disable sending;
# verification links will be returned in the API response for dev instead.
SYSTEM_SMTP_HOST=smtp.gmail.com
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_USERNAME=
SYSTEM_SMTP_PASSWORD=
SYSTEM_EMAIL_FROM=noreply@edmnexus.ai
SYSTEM_EMAIL_FROM_NAME=EDM Nexus
